    "event.doki.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join the event to earn characters, nameplates and stage backgrounds."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参与活动可获得角色、名牌以及舞台背景。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "イベントに参加してキャラクターやネームプレート、背景を獲得しよう。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이벤트에 참여해 캐릭터, 명찰, 무대 배경을 획득하세요."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Participez à l’événement pour gagner des personnages, plaques et décors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Participa en el evento para conseguir personajes, placas y fondos."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm am Event teil, um Charaktere, Namensschilder und Bühnenhintergründe zu erhalten."
          }
        }
      }
    },
